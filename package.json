{
  "name": "pi-telephone",
  "version": "0.1.1",
  "description": "Agent sessions call each other across machines on your Tailscale network, in Pi and Claude Code.",
  "license": "MIT",
  "author": "Nikita Sklyarov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ordinath/pi-telephone.git"
  },
  "homepage": "https://github.com/Ordinath/pi-telephone#readme",
  "bugs": {
    "url": "https://github.com/Ordinath/pi-telephone/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src",
    "pi",
    "skills",
    "commands",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "claude-code",
    "tailscale"
  ],
  "pi": {
    "extensions": [
      "./pi/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "bin": {
    "pi-telephone": "dist/cli.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0",
    "typebox": "^1.0.0",
    "typescript": "^5.0.0",
    "zod": "^4.6.5"
  }
}
