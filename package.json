{
  "name": "pi-telephone",
  "version": "0.1.0",
  "description": "Agent sessions call each other across machines on your Tailscale network, in Pi and Claude Code.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ordinath/pi-telephone.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src",
    "pi",
    "skills",
    "commands",
    ".claude-plugin",
    "README.md"
  ],
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./pi/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "bin": {
    "pi-telephone": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0",
    "typebox": "^1.0.0",
    "typescript": "^5.0.0",
    "zod": "^4.6.5"
  }
}
